# 复制成 .env 后填值：cp .env.example .env
# .env 已在 .gitignore 中（任何目录下的 .env 都不进版本库），不要提交真实值

# ── DeepSeek ──────────────────────────────────────────────
DS_BASE_URL=https://api.deepseek.com/v1
DS_API_KEY=sk-填你的key
DS_MODEL_NAME=deepseek-flash

# ── 米游社 ────────────────────────────────────────────────
# 绑定只在 QQ 里完成：给机器人发「绑定」，扫它回的二维码；凭据写到 ~/.hoyo/accounts/。
# 不再支持 HOYO_COOKIE / credential.properties（单用户时代的兜底已删除）。
# 游戏 UID 与区服：P9 起自动发现（GameRoleService），配置已废弃。
# 留空则自动生成并写入 ~/.hoyo/device-id；复现抓包会话时才需要填死
HOYO_DEVICE_ID=

# ── 每日自动签到（P9-8）────────────────────────────────────
# 00:10 跑一次；失败不自动重试，只记日志 + 落盘 + 通知（如果开了）
HOYO_CHECKIN_ENABLED=true
HOYO_CHECKIN_CRON=0 10 0 * * *
HOYO_CHECKIN_ZONE=Asia/Shanghai
# 应用错过 00:10（没开机）时，启动后延迟多久补签；设 0s = 立即
HOYO_CHECKIN_STARTUP_DELAY=60s
# 留空 = ~/.hoyo/checkin；测试/部署时指到可写目录
HOYO_CHECKIN_DIR=

# ── 存储后端（P1，2026-11-23）────────────────────────────────
# file = JSON/JSONL，便于直接看文件；sqlite = 单文件 + WAL，单机常驻推荐（docker compose 默认）。
# 只影响记忆与聊天历史；账号、签到记录目前两套后端都用文件。
HOYO_STORAGE_BACKEND=file
# 留空 = <state-dir>/hoyo.db；Docker 里 state-dir=/data
HOYO_SQLITE_PATH=
# SQLite 等锁上限；同机多进程写同一个库时才需要调
HOYO_SQLITE_BUSY_TIMEOUT=5s

# ── 会话记忆（不配也有默认值）──────────────────────────────
HOYO_MEMORY_MAX_MESSAGES=60
HOYO_MEMORY_MAX_SESSIONS=200
HOYO_MEMORY_IDLE_TTL=2h
# 超窗时先把更早的完整轮次压成摘要（放在窗口头部），而不是直接丢；失败才回退到按轮裁剪
HOYO_MEMORY_COMPACTION_ENABLED=true
HOYO_MEMORY_COMPACTION_TRIGGER=40
HOYO_MEMORY_COMPACTION_KEEP_TURNS=3
HOYO_MEMORY_COMPACTION_MAX_SUMMARY_CHARS=800

# ── QQ 官方机器人（P11，可选；默认关，不配不影响主服务）────────
# 设计见 docs/qq-inbound.md。接入：开放平台建机器人 → 事件订阅选 WebSocket
QQ_BOT_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
# 谁能用机器人由 QQ 开放平台控制（机器人可见范围/沙箱成员），代码里不再维护 openid 白名单。
# 注意：平台侧一旦放开给所有人，任何人都能私聊触发绑定/签到等操作，发布前先确认可见范围。
QQ_API_BASE=https://api.sgroup.qq.com


# file 后端：记忆落盘目录；留空 = ~/.hoyo/memory（切 sqlite 后只在迁移旧文件时读它）
HOYO_MEMORY_DIR=
# file 后端：磁盘保留期（不是内存 TTL）；超过这个时间的记忆文件会在每天 04:30 被清理
HOYO_MEMORY_RETENTION=30d

# ── 完整聊天历史（调试台只读查看）──────────────────────────────
# 只追加、不重写；只有带平台身份的轮次（QQ 私聊）才记，网页会话不进这里
HOYO_TRANSCRIPT_ENABLED=true
# 留空 = ~/.hoyo/transcripts；file 后端一个会话一个 .jsonl（sqlite 下只用于迁移旧文件）
HOYO_TRANSCRIPT_DIR=
# 两种后端都生效：超过这个时间的会话在每天 04:40 被清理；默认比记忆窗口长
HOYO_TRANSCRIPT_RETENTION=90d

# ── 签到结果推送（可选；默认关）──────────────────────────────
# 走独立 webhook，不占用 QQ 被动回复窗口（那个 5 分钟就过期，见 docs/qq-inbound.md §3）
HOYO_NOTIFY_ENABLED=false
HOYO_NOTIFY_URL=
HOYO_NOTIFY_KIND=generic
HOYO_NOTIFY_TIMEOUT=5s
