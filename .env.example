# 复制成 .env 后填值：cp .env.example .env
# .env 已在 .gitignore 中（仅根目录的那个），不要提交真实值

# ── DeepSeek ──────────────────────────────────────────────
DS_BASE_URL=https://api.deepseek.com/v1
DS_API_KEY=sk-填你的key
DS_MODEL_NAME=deepseek-flash

# ── 米游社（真实凭据，泄露等于账号被接管）──────────────────
# 快速路径：跑 scripts/login-qr.ps1 扫码，凭据会写到 ~/.hoyo/credential.properties，
#          那个文件带 stoken，优先级高于这里，重启后依然有效。
# 这条路只够查询；签到必须 stoken（见 docs/mihoyo-auth.md）。
# 备选：从浏览器 F12 复制完整 Cookie 串，至少包含 ltoken_v2 / ltuid_v2
HOYO_COOKIE=
# 游戏 UID 与区服：已废弃（P9 起自动发现，见 GameRoleService）。
# 保留说明只是为了解释旧 .env 里为什么有这两行——填了也不会被读取。
# HOYO_ROLE_ID=
# HOYO_SERVER=cn_gf01
# 账号标识：单用户阶段固定 local；多用户后由平台适配器注入（别填 QQ 号这类会泄露的值）
HOYO_USER_ID=local
# 留空则自动生成并写入 ~/.hoyo/device-id；复现抓包会话时才需要填死
HOYO_DEVICE_ID=

# ── 每日自动签到（P9-8）────────────────────────────────────
# 00:10 跑一次；失败不自动重试，只记日志 + 落盘，看 GET /api/checkin/status
HOYO_CHECKIN_ENABLED=true
HOYO_CHECKIN_CRON=0 10 0 * * *
HOYO_CHECKIN_ZONE=Asia/Shanghai
# 应用错过 00:10（没开机）时，启动后延迟多久补签；设 0s = 立即
HOYO_CHECKIN_STARTUP_DELAY=60s
# 留空 = ~/.hoyo/checkin；测试/部署时指到可写目录
HOYO_CHECKIN_DIR=

# ── 会话记忆（不配也有默认值）──────────────────────────────
HOYO_MEMORY_MAX_MESSAGES=20
HOYO_MEMORY_MAX_SESSIONS=200
HOYO_MEMORY_IDLE_TTL=2h
