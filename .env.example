# 复制成 .env 后填值：cp .env.example .env
# .env 已在 .gitignore 中（任何目录下的 .env 都不进版本库），不要提交真实值

# ── DeepSeek ──────────────────────────────────────────────
DS_BASE_URL=https://api.deepseek.com/v1
DS_API_KEY=sk-填你的key
DS_MODEL_NAME=deepseek-flash

# ── 米游社 ────────────────────────────────────────────────
# 绑定只在 QQ 里完成：给机器人发「绑定」，扫它回的二维码；凭据写到 ~/.hoyo/accounts/。
# 不再支持 HOYO_COOKIE / credential.properties（单用户时代的兜底已删除）。
# 游戏 UID 与区服：P9 起自动发现（GameRoleService），配置已废弃。
# 留空则自动生成并写入 ~/.hoyo/device-id；复现抓包会话时才需要填死
HOYO_DEVICE_ID=

# ── 每日自动签到（P9-8）────────────────────────────────────
# 00:10 跑一次；失败不自动重试，只记日志 + 落盘 + 通知（如果开了）HOYO_CHECKIN_ENABLED=true
HOYO_CHECKIN_CRON=0 10 0 * * *
HOYO_CHECKIN_ZONE=Asia/Shanghai
# 应用错过 00:10（没开机）时，启动后延迟多久补签；设 0s = 立即
HOYO_CHECKIN_STARTUP_DELAY=60s
# 留空 = ~/.hoyo/checkin；测试/部署时指到可写目录
HOYO_CHECKIN_DIR=

# ── 会话记忆（不配也有默认值）──────────────────────────────
HOYO_MEMORY_MAX_MESSAGES=20
HOYO_MEMORY_MAX_SESSIONS=200
HOYO_MEMORY_IDLE_TTL=2h

# ── QQ 官方机器人（P11，可选；默认关，不配不影响主服务）────────
# 设计见 docs/qq-inbound.md。接入：开放平台建机器人 → 事件订阅选 WebSocket
QQ_BOT_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
# 白名单存的是 openid（不是 QQ 号），从日志「忽略：openid=… 不在白名单」里抄；
# 为空 = 谁都不回（fail closed），不是"谁都能用"
QQ_ALLOWLIST=
# 沙箱环境改成 https://sandbox.api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com


# 记忆落盘目录；留空 = ~/.hoyo/memory
HOYO_MEMORY_DIR=
# 磁盘保留期（不是内存 TTL）：超过这个时间的记忆文件会在每天 04:30 被清理
HOYO_MEMORY_RETENTION=30d

# ── 签到结果推送（可选；默认关）──────────────────────────────
# 走独立 webhook，不占用 QQ 被动回复窗口（那个 5 分钟就过期，见 docs/qq-inbound.md §3）
HOYO_NOTIFY_ENABLED=false
HOYO_NOTIFY_URL=
HOYO_NOTIFY_KIND=generic
HOYO_NOTIFY_TIMEOUT=5s
